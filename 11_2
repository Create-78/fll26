#run covers missions: window to the past, humongous fungus, leafcutter frenzy
def run_zero(): 
  Robot.settings(straight_speed=200,straight_acceleration=500, turn_rate=150) #set drive speed, acceleration speed, and turn speed
  Robot.straight(410) #moves straight from home base to window to the past
  Left_Arm_Motor.run_angle(350,120) #moves arm down
  Robot.turn(-30) #turns the robot counter clockwise
  Left_Arm_Motor.run_angle(350,-30) #move arm up
  Left_Arm_Motor.run_angle(350, 20) #moves arm down
  Robot.turn(30) #turns robot clockwise
  Left_Arm_Motor.run_angle(360, 20) 
  Robot.straight (260) #runs arm straight to humongous fungus
  Left_Arm_Motor.run_angle (3000,-15) #moves arm up to hook the mission arm
  Robot.straight (-50) #pulls mission arm back
  Robot.turn (-80) #turns robot counter clockwise
  Left_Arm_Motor.run_angle (-350,100) #moves arm up
  Robot.straight (350) #moves robot straight to position for leafcutter frenzy
  Robot.turn (-60) #turns robot counter clockwise
  Robot.straight (-300) #moves robot backward to push in leafcutter frenzy arm
  Robot.straight (100) #moves robot forward to build up to the next push
  Robot.straight (-200) #moves robot backward to push in leafcutter frenzy arm
  Robot.turn (100) #turns robot to make a run back home
  Robot.straight (-1000) #robot runs back home
  
